{
  "info": {
    "_postman_id": "8b8b4f6e-4b0a-4f35-9b71-xolvon-api",
    "name": "Xolvon API - Complete Collection",
    "description": "Koleksi endpoint backend Xolvon. Global prefix API adalah /api. Isi variabel baseUrl, email, password, adminEmail, dan adminPassword sebelum menjalankan. Request login otomatis menyimpan accessToken dan refreshToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://localhost:3000/api"},
    {"key":"accessToken","value":""},
    {"key":"refreshToken","value":""},
    {"key":"email","value":"user@example.com"},
    {"key":"password","value":"Password123!"},
    {"key":"adminEmail","value":"admin@example.com"},
    {"key":"adminPassword","value":"Password123!"},
    {"key":"userId","value":"00000000-0000-4000-8000-000000000000"},
    {"key":"courseId","value":"00000000-0000-4000-8000-000000000000"},
    {"key":"courseSlug","value":"contoh-course"},
    {"key":"lessonId","value":"00000000-0000-4000-8000-000000000000"},
    {"key":"projectId","value":"00000000-0000-4000-8000-000000000000"},
    {"key":"projectSlug","value":"contoh-project"},
    {"key":"memberId","value":"00000000-0000-4000-8000-000000000000"},
    {"key":"memberSlug","value":"contoh-member"},
    {"key":"marketplaceId","value":"00000000-0000-4000-8000-000000000000"},
    {"key":"marketplaceSlug","value":"contoh-produk"},
    {"key":"orderId","value":"00000000-0000-4000-8000-000000000000"},
    {"key":"enrollmentId","value":"00000000-0000-4000-8000-000000000000"},
    {"key":"mediaId","value":"00000000-0000-4000-8000-000000000000"},
    {"key":"resourceId","value":"00000000-0000-4000-8000-000000000000"}
  ],
  "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},
  "event": [{"listen":"prerequest","script":{"type":"text/javascript","exec":["pm.request.headers.upsert({key: 'Accept', value: 'application/json'});"]}}],
  "item": [
    {
      "name":"00. Health & Public",
      "item":[
        {"name":"Health check","request":{"method":"GET","url":"{{baseUrl}}"}},
        {"name":"Home aggregation","request":{"method":"GET","url":"{{baseUrl}}/home"}},
        {"name":"Search published content","request":{"method":"GET","url":{"raw":"{{baseUrl}}/search?q={{searchQuery}}&type={{searchType}}&page=1&limit=20","host":["{{baseUrl}}"],"path":["search"],"query":[{"key":"q","value":"{{searchQuery}}"},{"key":"type","value":"{{searchType}}"},{"key":"page","value":"1"},{"key":"limit","value":"20"}]}},"variable":[{"key":"searchQuery","value":"web"},{"key":"searchType","value":""}]}
      ]
    },
    {
      "name":"01. Auth",
      "item":[
        {"name":"Register user","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Xolvon User\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"+6281234567890\",\n  \"password\": \"{{password}}\"\n}"},"url":"{{baseUrl}}/auth/register"}},
        {"name":"Login user - save tokens","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const json = pm.response.json();","if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);","if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);","pm.test('Login berhasil', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"},"url":"{{baseUrl}}/auth/login"}},
        {"name":"Login admin - save tokens","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const json = pm.response.json();","if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);","if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"},"url":"{{baseUrl}}/auth/login"}},
        {"name":"Current user","request":{"method":"GET","url":"{{baseUrl}}/auth/me"}},
        {"name":"Admin access check","request":{"method":"GET","url":"{{baseUrl}}/auth/admin"}},
        {"name":"Refresh access token","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const json = pm.response.json();","if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"},"url":"{{baseUrl}}/auth/refresh"}},
        {"name":"Logout","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"},"url":"{{baseUrl}}/auth/logout"}}
      ]
    },
    {
      "name":"02. Courses & Lessons",
      "item":[
        {"name":"List published courses","request":{"method":"GET","url":"{{baseUrl}}/courses?page=1&limit=20&sort=latest&q="}},
        {"name":"Get published course","request":{"method":"GET","url":"{{baseUrl}}/courses/{{courseSlug}}"}},
        {"name":"Admin create course","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"Course Contoh\",\n  \"slug\": \"course-contoh\",\n  \"description\": \"Deskripsi course contoh.\",\n  \"price\": 150000,\n  \"thumbnailUrl\": \"https://example.com/thumb.webp\"\n}"},"url":"{{baseUrl}}/courses"}},
        {"name":"Admin update course","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"description\": \"Deskripsi diperbarui.\",\n  \"price\": 175000\n}"},"url":"{{baseUrl}}/courses/{{courseId}}"}},
        {"name":"Publish course","request":{"method":"POST","url":"{{baseUrl}}/courses/{{courseId}}/publish"}},
        {"name":"Unpublish course","request":{"method":"POST","url":"{{baseUrl}}/courses/{{courseId}}/unpublish"}},
        {"name":"List course lessons","request":{"method":"GET","url":"{{baseUrl}}/courses/{{courseSlug}}/lessons"}},
        {"name":"Create lesson","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"Lesson Pertama\",\n  \"content\": \"Materi lesson.\",\n  \"orderIndex\": 0\n}"},"url":"{{baseUrl}}/courses/{{courseId}}/lessons"}},
        {"name":"Update lesson","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"Lesson Diperbarui\",\n  \"orderIndex\": 1\n}"},"url":"{{baseUrl}}/lessons/{{lessonId}}"}},
        {"name":"Delete lesson","request":{"method":"DELETE","url":"{{baseUrl}}/lessons/{{lessonId}}"}},
        {"name":"Reorder lesson","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"orderIndex\": 2\n}"},"url":"{{baseUrl}}/lessons/{{lessonId}}/reorder"}},
        {"name":"Publish lesson","request":{"method":"POST","url":"{{baseUrl}}/lessons/{{lessonId}}/publish"}},
        {"name":"Unpublish lesson","request":{"method":"POST","url":"{{baseUrl}}/lessons/{{lessonId}}/unpublish"}},
        {"name":"Get lesson video URL","request":{"method":"GET","url":"{{baseUrl}}/lessons/{{lessonId}}/video-url"}},
        {"name":"Create lesson resource","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"type\": \"pdf\",\n  \"objectKey\": \"private/courses/course/material.pdf\",\n  \"title\": \"Materi PDF\"\n}"},"url":"{{baseUrl}}/lessons/{{lessonId}}/resources"}},
        {"name":"Delete lesson resource","request":{"method":"DELETE","url":"{{baseUrl}}/resources/{{resourceId}}"}}
      ]
    },
    {
      "name":"03. Projects",
      "item":[
        {"name":"List published projects","request":{"method":"GET","url":"{{baseUrl}}/projects?page=1&limit=20&sort=latest&q="}},
        {"name":"Get published project","request":{"method":"GET","url":"{{baseUrl}}/projects/{{projectSlug}}"}},
        {"name":"Create project","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"Project Contoh\",\n  \"slug\": \"project-contoh\",\n  \"type\": \"web\",\n  \"summary\": \"Ringkasan project.\",\n  \"problem\": \"Masalah yang diselesaikan.\",\n  \"solution\": \"Solusi yang dibuat.\",\n  \"techStack\": \"NestJS, TypeScript, SQLite\",\n  \"result\": \"Hasil project.\"\n}"},"url":"{{baseUrl}}/projects"}},
        {"name":"Update project","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"summary\": \"Ringkasan diperbarui.\"\n}"},"url":"{{baseUrl}}/projects/{{projectId}}"}},
        {"name":"Publish project","request":{"method":"POST","url":"{{baseUrl}}/projects/{{projectId}}/publish"}},
        {"name":"Unpublish project","request":{"method":"POST","url":"{{baseUrl}}/projects/{{projectId}}/unpublish"}},
        {"name":"Attach project media","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"objectKey\": \"public/projects/project/image.webp\",\n  \"mediaType\": \"image\",\n  \"sortOrder\": 0\n}"},"url":"{{baseUrl}}/projects/{{projectId}}/media"}},
        {"name":"Detach project media","request":{"method":"DELETE","url":"{{baseUrl}}/projects/{{projectId}}/media/{{mediaId}}"}},
        {"name":"Assign project member","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"memberId\": \"{{memberId}}\",\n  \"role\": \"Developer\"\n}"},"url":"{{baseUrl}}/projects/{{projectId}}/members"}},
        {"name":"Remove project member","request":{"method":"DELETE","url":"{{baseUrl}}/projects/{{projectId}}/members/{{memberId}}"}}
      ]
    },
    {
      "name":"04. Collective",
      "item":[
        {"name":"List published collective","request":{"method":"GET","url":"{{baseUrl}}/collective?page=1&limit=20&q="}},
        {"name":"Get collective member","request":{"method":"GET","url":"{{baseUrl}}/collective/{{memberSlug}}"}},
        {"name":"Create collective member","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Nama Anggota\",\n  \"slug\": \"nama-anggota\",\n  \"photo\": \"https://example.com/photo.webp\",\n  \"role\": \"Developer\",\n  \"skills\": [\"TypeScript\", \"UI/UX\"],\n  \"bio\": \"Bio singkat.\",\n  \"socialLinks\": [{\"platform\":\"github\",\"url\":\"https://github.com/example\"}],\n  \"displayOrder\": 0\n}"},"url":"{{baseUrl}}/collective"}},
        {"name":"Update collective member","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"role\": \"Senior Developer\"\n}"},"url":"{{baseUrl}}/collective/{{memberId}}"}},
        {"name":"Publish collective member","request":{"method":"POST","url":"{{baseUrl}}/collective/{{memberId}}/publish"}},
        {"name":"Unpublish collective member","request":{"method":"POST","url":"{{baseUrl}}/collective/{{memberId}}/unpublish"}}
      ]
    },
    {
      "name":"05. Marketplace",
      "item":[
        {"name":"List marketplace","request":{"method":"GET","url":"{{baseUrl}}/marketplace?page=1&limit=20&sort=latest&q="}},
        {"name":"Get marketplace item","request":{"method":"GET","url":"{{baseUrl}}/marketplace/{{marketplaceSlug}}"}},
        {"name":"Create marketplace item","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"Produk Contoh\",\n  \"slug\": \"produk-contoh\",\n  \"description\": \"Deskripsi produk.\",\n  \"externalUrl\": \"https://example.com/product\",\n  \"capabilities\": [\"Dashboard\", \"API\"]\n}"},"url":"{{baseUrl}}/marketplace"}},
        {"name":"Update marketplace item","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"description\": \"Deskripsi diperbarui.\"\n}"},"url":"{{baseUrl}}/marketplace/{{marketplaceId}}"}},
        {"name":"Publish marketplace item","request":{"method":"POST","url":"{{baseUrl}}/marketplace/{{marketplaceId}}/publish"}},
        {"name":"Unpublish marketplace item","request":{"method":"POST","url":"{{baseUrl}}/marketplace/{{marketplaceId}}/unpublish"}},
        {"name":"Attach marketplace media","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"objectKey\": \"public/site/marketplace/image.webp\",\n  \"mediaType\": \"image\",\n  \"sortOrder\": 0\n}"},"url":"{{baseUrl}}/marketplace/{{marketplaceId}}/media"}},
        {"name":"Detach marketplace media","request":{"method":"DELETE","url":"{{baseUrl}}/marketplace/{{marketplaceId}}/media/{{mediaId}}"}}
      ]
    },
    {
      "name":"06. Orders & Learning",
      "item":[
        {"name":"Checkout order","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"courseIds\": [\"{{courseId}}\"],\n  \"notes\": \"Pembayaran via transfer.\"\n}"},"url":"{{baseUrl}}/orders"}},
        {"name":"Submit payment proof","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"objectKey\": \"private/orders/{{orderId}}/payment-proof.jpg\"\n}"},"url":"{{baseUrl}}/orders/{{orderId}}/payment-proof"}},
        {"name":"Verify order - admin","request":{"method":"PATCH","url":"{{baseUrl}}/orders/{{orderId}}/verify"}},
        {"name":"Activate order - admin","request":{"method":"POST","url":"{{baseUrl}}/orders/{{orderId}}/activate"}},
        {"name":"Cancel order - admin","request":{"method":"POST","url":"{{baseUrl}}/orders/{{orderId}}/cancel"}},
        {"name":"List my enrollments","request":{"method":"GET","url":"{{baseUrl}}/enrollments/me"}},
        {"name":"Revoke enrollment - admin","request":{"method":"PATCH","url":"{{baseUrl}}/enrollments/{{enrollmentId}}/revoke"}},
        {"name":"Update lesson progress","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"lessonId\": \"{{lessonId}}\",\n  \"completed\": true\n}"},"url":"{{baseUrl}}/progress"}},
        {"name":"List my progress","request":{"method":"GET","url":"{{baseUrl}}/progress"}}
      ]
    },
    {
      "name":"07. Admin & Media",
      "item":[
        {"name":"Admin overview","request":{"method":"GET","url":"{{baseUrl}}/admin/overview"}},
        {"name":"Admin list users","request":{"method":"GET","url":"{{baseUrl}}/admin/users?page=1&limit=20&q="}},
        {"name":"Admin user detail","request":{"method":"GET","url":"{{baseUrl}}/admin/users/{{userId}}"}},
        {"name":"Admin list orders","request":{"method":"GET","url":"{{baseUrl}}/admin/orders?page=1&limit=20&q=&status="}},
        {"name":"Create media upload URL","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"prefix\": \"public/site\",\n  \"contentType\": \"image/webp\",\n  \"size\": 102400,\n  \"filename\": \"hero.webp\"\n}"},"url":"{{baseUrl}}/admin/media/upload-url"}},
        {"name":"Confirm media upload","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"key\": \"public/site/generated-key.webp\"\n}"},"url":"{{baseUrl}}/admin/media/confirm"}},
        {"name":"Create private media read URL","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"key\": \"private/courses/course/video.mp4\"\n}"},"url":"{{baseUrl}}/admin/media/read-url"}}
      ]
    }
  ]
}
