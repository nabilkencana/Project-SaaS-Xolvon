# Environment template for QA and automated testing sessions.
# Copy to .env.test and populate with isolated test credentials.
# WARNING: Never commit .env.test or real production secrets to version control.

APP_ENV=test
PORT=3005
DB_DRIVER=sqlite
STORAGE_DRIVER=local-test

# Local Test Database & Storage
JWT_SECRET=super-secure-local-qa-test-jwt-secret-at-least-32-chars!
FRONTEND_URL=http://localhost:3001

# QA Admin Credentials (for local and staging testing drivers)
QA_ADMIN_EMAIL=admin@xolvon.com
QA_ADMIN_PASSWORD=
QA_LOCAL_ADMIN_EMAIL=admin@example.com
QA_LOCAL_ADMIN_PASSWORD=ChangeMe-Admin-123!

# Target endpoints for test runners
LOCAL_API_URL=http://localhost:3005/api
DEPLOYED_API_URL=https://xolvon.canadev.my.id/api

# Optional Cloudflare R2 testing credentials
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
