# Local runtime environment. Keep staging and production values in their
# deployment secret managers; never copy them into a local .env file.
# WARNING: Never commit real credentials or secret values to this file or the repository.
APP_ENV=local

# Database driver — "sqlite" (default, local development via better-sqlite3) or "d1" (Cloudflare D1)
# Saat DB_DRIVER=d1, variabel CLOUDFLARE_* di bawah menjadi WAJIB.
DB_DRIVER=sqlite

# Cloudflare D1 (Database) — required only when DB_DRIVER=d1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# JWT Authentication — REQUIRED (secret must be >= 32 characters)
JWT_SECRET=

# Trusted proxy hops for rate limiting (T6). Unset/blank = trust NO proxy:
# req.ip (throttler tracker) stays the socket IP, so X-Forwarded-For cannot
# spoof per-IP limits on local runs. Staging/production set 1 (one edge hop).
TRUST_PROXY_HOPS=

# App — REQUIRED (validated at bootstrap; PORT must be 1-65535, default 3000)
PORT=3000
FRONTEND_URL=http://localhost:3001

# CORS_ALLOWED_ORIGINS — comma-separated, explicit browser-origin whitelist
# consumed by src/config/cors.ts for CORS AND the request-integrity guard.
# WILDCARDS ARE REJECTED ("*") because CORS credentials are always enabled.
# Resolution order: CORS_ALLOWED_ORIGINS -> FRONTEND_URL -> local dev origin.
# Leave blank (as here) to fall back to FRONTEND_URL. List only real, explicit
# origins (names belong here; values never in docs or Git).
CORS_ALLOWED_ORIGINS=

# Storage driver — local-test for local development or r2 for Cloudflare R2
STORAGE_DRIVER=local-test
R2_ENDPOINT=
R2_BUCKET=xolvon-storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Controlled admin bootstrap only. Do not set these for normal application runs.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
