# Production runtime environment.
# Production uses Cloudflare D1 and R2. Store all secret values in the
# deployment secret manager and never commit them to this file or the repository.
APP_ENV=production
DB_DRIVER=d1
STORAGE_DRIVER=r2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
JWT_SECRET=
FRONTEND_URL=
PORT=
