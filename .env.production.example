# Production runtime environment.
# Production uses Cloudflare D1 and R2. Store all secret values in the
# deployment secret manager and never commit them to this file or the repository.
APP_ENV=production
DB_DRIVER=d1
STORAGE_DRIVER=r2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
JWT_SECRET=
FRONTEND_URL=
PORT=

# Rate limiting runs behind exactly one trusted edge proxy (Cloudflare ->
# app), so req.ip resolves the real client from X-Forwarded-For (T6).
# Keep 1: a larger value would trust attacker-controllable header entries.
TRUST_PROXY_HOPS=1
